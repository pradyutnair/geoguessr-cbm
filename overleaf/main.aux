\@writefile{toc}{\contentsline {subsection}{\numberline {A.1}Successful Predictions}{16}{subsection.A.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Successful prediction for a European scene. The patch attention heatmap reveals focus on road geometry and built structures. Concept predictions capture semantic categories relevant to the predicted region, with balanced concept-image fusion (gate 0.47).\relax }}{16}{figure.caption.12}\protected@file@percent }
\newlabel{fig:interpretability_example_b}{{7}{16}{Successful prediction for a European scene. The patch attention heatmap reveals focus on road geometry and built structures. Concept predictions capture semantic categories relevant to the predicted region, with balanced concept-image fusion (gate 0.47).\relax }{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Successful prediction for a West African scene. The model identifies this location through distinctive visual cues including unique vehicles and license plates (gate 0.431). Top child concepts: ``Unique car'', ``License Plates''; parent concepts: ``car\_meta'', ``landscape\_savannah''.\relax }}{17}{figure.caption.13}\protected@file@percent }
\newlabel{fig:interpretability_example_a}{{8}{17}{Successful prediction for a West African scene. The model identifies this location through distinctive visual cues including unique vehicles and license plates (gate 0.431). Top child concepts: ``Unique car'', ``License Plates''; parent concepts: ``car\_meta'', ``landscape\_savannah''.\relax }{figure.caption.13}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {A.2}Failure Cases}{18}{subsection.A.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Failure case: French infrastructure misattribution. The model correctly identifies ``French Infrastructure'' and ``Chevrons'' concepts but predicts Tunisia (35.4$^\circ $N, 10.2$^\circ $E) instead of the actual location. This illustrates colonial-era infrastructure creating misleading geographic associations.\relax }}{18}{figure.caption.14}\protected@file@percent }
\newlabel{fig:failure_french}{{9}{18}{Failure case: French infrastructure misattribution. The model correctly identifies ``French Infrastructure'' and ``Chevrons'' concepts but predicts Tunisia (35.4$^\circ $N, 10.2$^\circ $E) instead of the actual location. This illustrates colonial-era infrastructure creating misleading geographic associations.\relax }{figure.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Failure case: Hallucinated bollard concepts. The model predicts ``Bollards'' and ``Austrian bollards'' for a forested scene (42.6$^\circ $N, 19.2$^\circ $E) where no bollards are visible. The model mistakes the camera shadow for a bollard and relies on landscape features that correlate with Central European regions in training data rather than actual bollard detection.\relax }}{19}{figure.caption.15}\protected@file@percent }
\newlabel{fig:failure_bollard}{{10}{19}{Failure case: Hallucinated bollard concepts. The model predicts ``Bollards'' and ``Austrian bollards'' for a forested scene (42.6$^\circ $N, 19.2$^\circ $E) where no bollards are visible. The model mistakes the camera shadow for a bollard and relies on landscape features that correlate with Central European regions in training data rather than actual bollard detection.\relax }{figure.caption.15}{}}
