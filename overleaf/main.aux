\newlabel{fig:stage0}{{1a}{4}{Stage 0: Domain Contrastive Pretraining\relax }{figure.caption.1}{}}
\newlabel{sub@fig:stage0}{{a}{4}{Stage 0: Domain Contrastive Pretraining\relax }{figure.caption.1}{}}
\newlabel{fig:stage1_2}{{1b}{4}{Stage 1: Concept Learning and Stage 2: Geolocation\relax }{figure.caption.1}{}}
\newlabel{sub@fig:stage1_2}{{b}{4}{Stage 1: Concept Learning and Stage 2: Geolocation\relax }{figure.caption.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Conceptual overview of the three-stage architecture for concept-aware geolocation. \textbf  {(a) Stage 0} performs domain contrastive pretraining to align image, GPS, and concept embeddings, with a GPS adapter ($512\text  {d} \to 768\text  {d}$) projecting GeoCLIP location features to match StreetCLIP image features. \textbf  {(b) Stage 1} learns hierarchical concept classification through text-anchored prototypes with cosine similarity. \textbf  {Stage 2} predicts geographic coordinates via learned gated fusion: concept embeddings and image embeddings are combined through cross-attention and a cell classification head with offset regression.\relax }}{4}{figure.caption.1}\protected@file@percent }
\newlabel{fig:architecture}{{1}{4}{Conceptual overview of the three-stage architecture for concept-aware geolocation. \textbf {(a) Stage 0} performs domain contrastive pretraining to align image, GPS, and concept embeddings, with a GPS adapter ($512\text {d} \to 768\text {d}$) projecting GeoCLIP location features to match StreetCLIP image features. \textbf {(b) Stage 1} learns hierarchical concept classification through text-anchored prototypes with cosine similarity. \textbf {Stage 2} predicts geographic coordinates via learned gated fusion: concept embeddings and image embeddings are combined through cross-attention and a cell classification head with offset regression.\relax }{figure.caption.1}{}}
